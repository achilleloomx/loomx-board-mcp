# DB backend — two supported modes (DATABASE_URL takes precedence):
#
# 1) Direct postgres (preferred for dev with local Supabase / pooler)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
#
# 2) Supabase service_role (bypasses RLS — backwards-compatible legacy mode)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# doc_* tools — doc_rw wiring (D-a5 F4.5). The document-model tools (doc_create,
# doc_item_upsert, doc_item_resolve, doc_link, doc_link_by_code, doc_supersede,
# doc_query) run under the NON-bypass DB role `doc_rw` with the caller's slug
# bound into the GUC request.agent_slug → RLS (D-015) enforced per agent. The
# other tools (board_*, gtd_*, wi_*) keep using the mode above. doc_* REFUSE to
# run without one of these (no service_role bypass — contract rule #4):
#
#   PRODUCTION — direct postgres, login role with GRANT doc_rw (Supavisor 5432):
# DOC_RW_DATABASE_URL=postgresql://<login_role>:<pwd>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
#
#   SMOKE/DEV ONLY — Supabase Management API as postgres (per-query tx, NOT atomic):
# SUPABASE_MGMT_PAT=sbp_...
# SUPABASE_PROJECT_REF=fvoxccwfysazwpchudwp

# Home tools (optional — enables home_* tools for family data access)
# Required for agents that need grocery/menu/school menu operations (e.g. assistant)
#
# HOME_FAMILY_ID = uuid of the family row in home_families
# HOME_USER_ID   = uuid of the Supabase auth.users(id) that "owns" the session.
#                  MUST be a valid auth user — it's written into
#                  home_shopping_items.added_by / checked_by which FK to
#                  auth.users(id). A family member_id or a profile id will
#                  cause FK violation errors in home_grocery_add (see D-017).
# HOME_FAMILY_ID=<uuid>
# HOME_USER_ID=<uuid>

# WI template catalog (optional — soft-warn validation in wi_start, GTD f67f9524).
# Points to the hub/templates/work-items/ directory (sibling repo, not bundled
# here). Unset = validation skipped entirely (no impact on agents that haven't
# configured it). Unknown template_name → template_warning in wi_start response,
# never a hard failure — hard-fail is deferred to a grace period agreed with Loomy.
# WI_TEMPLATES_PATH=/path/to/hub/templates/work-items

# LoomX Chat — remote entrypoint (node dist/index.js --remote) for claude.ai.
# Only needed for the remote MCP instance (not the per-agent stdio instances).
#
# LOOMX_CHAT_TOKEN       = strong bearer token Achille pastes into claude.ai.
#                          Required (server refuses to start without it, unless
#                          LOOMX_CHAT_ALLOW_NOAUTH=1). Generate: openssl rand -base64 32
# LOOMX_CHAT_ALLOW_NOAUTH= set to 1 to skip auth (tailscale-only local test ONLY)
# LOOMX_CHAT_PORT        = listen port (default 8787)
# LOOMX_CHAT_HOST        = bind host (default 127.0.0.1 — keep loopback behind Caddy)
# LOOMX_CHAT_TOKEN=<token>
# LOOMX_CHAT_PORT=8787
# LOOMX_CHAT_HOST=127.0.0.1
